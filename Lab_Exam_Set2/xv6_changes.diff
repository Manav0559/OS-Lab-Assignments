diff --git a/prottest.c b/prottest.c
new file mode 100644
index 0000000..bdd0c6e
--- /dev/null
+++ b/prottest.c
@@ -0,0 +1,48 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int
+main(void)
+{
+  char *p;
+  int pid;
+
+  p = sbrk(4096);
+  if(p == (char*)-1){
+    printf(1, "sbrk failed\n");
+    exit();
+  }
+  printf(1, "page at 0x%x, page aligned: %s\n", (uint)p, ((uint)p % 4096) == 0 ? "yes" : "no");
+  p[0] = 'A';
+  printf(1, "wrote %c\n", p[0]);
+
+  printf(1, "\n(i) mprotect(p, 1) = %d\n", mprotect(p, 1));
+  printf(1, "    read after mprotect: %c\n", p[0]);
+
+  printf(1, "\n(ii) child tries to write to the read-only page\n");
+  pid = fork();
+  if(pid < 0){
+    printf(1, "fork failed\n");
+    exit();
+  }
+  if(pid == 0){
+    p[0] = 'B';
+    printf(1, "    child: write went through, this is wrong\n");
+    exit();
+  }
+  wait();
+  printf(1, "    parent: child %d is gone, page still has %c\n", pid, p[0]);
+
+  printf(1, "\n(iii) munprotect(p, 1) = %d\n", munprotect(p, 1));
+  p[0] = 'C';
+  printf(1, "     write after munprotect: %c\n", p[0]);
+
+  printf(1, "\n(iv) error cases\n");
+  printf(1, "     mprotect(p + 1, 1)    = %d   unaligned address\n", mprotect(p + 1, 1));
+  printf(1, "     mprotect(p, 0)        = %d   len = 0\n", mprotect(p, 0));
+  printf(1, "     mprotect(p, -2)       = %d   len < 0\n", mprotect(p, -2));
+  printf(1, "     mprotect(p, 2)        = %d   range goes past sz\n", mprotect(p, 2));
+  printf(1, "     mprotect(p + 4096, 1) = %d   page after sz\n", mprotect(p + 4096, 1));
+  exit();
+}
diff --git a/schedtest.c b/schedtest.c
new file mode 100644
index 0000000..cf94ba9
--- /dev/null
+++ b/schedtest.c
@@ -0,0 +1,45 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+#define LOOPS 40000000
+
+int
+main(void)
+{
+  int prio[3] = {5, 10, 15};
+  int pid[3];
+  int i, old;
+  volatile int x;
+
+  old = set_priority(getpid(), 1);
+  printf(1, "parent pid %d: priority %d -> 1\n", getpid(), old);
+
+  for(i = 0; i < 3; i++){
+    pid[i] = fork();
+    if(pid[i] < 0){
+      printf(1, "fork failed\n");
+      exit();
+    }
+    if(pid[i] == 0){
+      int start = uptime();
+      for(x = 0; x < LOOPS; x++)
+        ;
+      printf(1, "child pid %d priority %d finished (ran from tick %d to %d)\n",
+             getpid(), prio[i], start, uptime());
+      exit();
+    }
+  }
+
+  for(i = 0; i < 3; i++){
+    old = set_priority(pid[i], prio[i]);
+    printf(1, "set_priority(%d, %d) returned old priority %d\n", pid[i], prio[i], old);
+  }
+  printf(1, "set_priority(9999, 5) = %d, set_priority(%d, 21) = %d\n",
+         set_priority(9999, 5), pid[0], set_priority(pid[0], 21));
+
+  for(i = 0; i < 3; i++)
+    wait();
+  printf(1, "Done\n");
+  exit();
+}
