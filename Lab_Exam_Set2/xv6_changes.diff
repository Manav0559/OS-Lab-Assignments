diff --git a/sysproc.c b/sysproc.c
index 0686d29..c0741b9 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,33 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+int
+sys_mprotect(void)
+{
+  int addr, len;
+
+  if(argint(0, &addr) < 0 || argint(1, &len) < 0)
+    return -1;
+  return setwritable(myproc()->pgdir, myproc()->sz, (uint)addr, len, 0);
+}
+
+int
+sys_munprotect(void)
+{
+  int addr, len;
+
+  if(argint(0, &addr) < 0 || argint(1, &len) < 0)
+    return -1;
+  return setwritable(myproc()->pgdir, myproc()->sz, (uint)addr, len, 1);
+}
+
+int
+sys_set_priority(void)
+{
+  int pid, priority;
+
+  if(argint(0, &pid) < 0 || argint(1, &priority) < 0)
+    return -1;
+  return set_priority(pid, priority);
+}
