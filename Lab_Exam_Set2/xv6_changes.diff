diff --git a/vm.c b/vm.c
index 7134cff..5212e40 100644
--- a/vm.c
+++ b/vm.c
@@ -392,3 +392,33 @@ copyout(pde_t *pgdir, uint va, void *p, uint len)
 //PAGEBREAK!
 // Blank page.
 
+
+int
+setwritable(pde_t *pgdir, uint sz, uint addr, int len, int writable)
+{
+  uint a, end;
+  pte_t *pte;
+
+  if(addr % PGSIZE != 0 || len <= 0 || len > sz / PGSIZE)
+    return -1;
+  end = addr + len * PGSIZE;
+  if(end > sz)
+    return -1;
+
+  for(a = addr; a < end; a += PGSIZE){
+    pte = walkpgdir(pgdir, (char*)a, 0);
+    if(pte == 0 || !(*pte & PTE_P) || !(*pte & PTE_U))
+      return -1;
+  }
+
+  for(a = addr; a < end; a += PGSIZE){
+    pte = walkpgdir(pgdir, (char*)a, 0);
+    if(writable)
+      *pte |= PTE_W;
+    else
+      *pte &= ~PTE_W;
+  }
+
+  lcr3(V2P(pgdir));
+  return 0;
+}
