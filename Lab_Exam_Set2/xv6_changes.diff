   }
 }
+
+int
+set_priority(int pid, int priority)
+{
+  struct proc *p;
+  int old;
+
+  if(priority < 1 || priority > 20)
+    return -1;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      old = p->priority;
+      p->priority = priority;
+      release(&ptable.lock);
+      return old;
+    }
+  }
+  release(&ptable.lock);
+  return -1;
+}
