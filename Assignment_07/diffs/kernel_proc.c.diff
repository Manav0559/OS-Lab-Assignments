+uint64
+userlimit(struct proc *p)
+{
+  struct proc *q;
+
+  for (q = proc; q < &proc[NPROC]; q++)
+    if (q != p && q->state != UNUSED && q->pagetable == p->pagetable)
+      return USERTOP;
+  return TRAPFRAME;
+}
