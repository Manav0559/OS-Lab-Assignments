+static int
+jointhread(struct proc *p, int force)
+{
+  struct proc *pp;
+  int havethreads, pid;
+
+  acquire(&wait_lock);
+
+  for (;;) {
+    havethreads = 0;
+    for (pp = proc; pp < &proc[NPROC]; pp++) {
+      if (pp->parent == p && pp->isthread) {
+        acquire(&pp->lock);
+        havethreads = 1;
+        if (pp->state == ZOMBIE) {
+          pid = pp->pid;
+          pp->parent = 0;
+          freeproc(pp);
+          release(&pp->lock);
+          release(&wait_lock);
+          return pid;
+        }
+        release(&pp->lock);
+      }
+    }
+
+    if (!havethreads || (!force && killed(p))) {
+      release(&wait_lock);
+      return -1;
+    }
+
+    sleep_prepare(p);
+    release(&wait_lock);
+    sleep();
+    acquire(&wait_lock);
+  }
+}
