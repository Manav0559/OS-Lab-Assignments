+int
+vmprint(pde_t *pgdir)
+{
+  uint pdx, ptx, va;
+  pte_t *pte;
+  int pages = 0, userpts = 0, kernpts = 0;
+
+  cprintf("page table of pid %d  (pgdir pa 0x%x, sz %d bytes)\n", myproc()->pid, V2P(pgdir), myproc()->sz);
+  cprintf("  VA          PA          flags\n");
+  for(pdx = 0; pdx < NPDENTRIES; pdx++){
+    if(!(pgdir[pdx] & PTE_P))
+      continue;
+    if(PGADDR(pdx, 0, 0) >= KERNBASE){
+      kernpts++;
+      continue;
+    }
+    userpts++;
+    for(ptx = 0; ptx < NPTENTRIES; ptx++){
+      va = PGADDR(pdx, ptx, 0);
+      pte = walkpgdir(pgdir, (void*)va, 0);
+      if(pte == 0 || !(*pte & PTE_P))
+        continue;
+      pages++;
+      cprintf("  0x%x  0x%x   P=%d W=%d U=%d%s\n", va, PTE_ADDR(*pte), 1, (*pte & PTE_W) != 0,
+              (*pte & PTE_U) != 0, (*pte & PTE_U) ? "" : "   (stack guard page)");
+    }
   }
+  cprintf("valid user pages: %d\n", pages);
+  cprintf("page-table pages: %d (1 page directory + %d user page table%s; %d kernel page tables not counted)\n",
+          1 + userpts, userpts, userpts == 1 ? "" : "s", kernpts);
+  return pages;
+}
+
+int
+lazyalloc(pde_t *pgdir, uint va)
+{
+  char *mem;
+
+  if((mem = kalloc()) == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(pgdir, (char*)PGROUNDDOWN(va), PGSIZE, V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
   return 0;
 }
