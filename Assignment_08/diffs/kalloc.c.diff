--- xv6-original/kalloc.c
+++ xv6-a8/kalloc.c
@@ -16,6 +16,8 @@
   struct spinlock lock;
   int use_lock;
   struct run *freelist;
+  int nfree;
+  int ntotal;
 } kmem;
 
 void
@@ -38,8 +40,10 @@
 {
   char *p;
   p = (char*)PGROUNDUP((uint)vstart);
-  for(; p + PGSIZE <= (char*)vend; p += PGSIZE)
+  for(; p + PGSIZE <= (char*)vend; p += PGSIZE){
     kfree(p);
+    kmem.ntotal++;
+  }
 }
 
 void
@@ -57,6 +61,7 @@
   r = (struct run*)v;
   r->next = kmem.freelist;
   kmem.freelist = r;
+  kmem.nfree++;
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -69,9 +74,20 @@
   if(kmem.use_lock)
     acquire(&kmem.lock);
   r = kmem.freelist;
-  if(r)
+  if(r){
     kmem.freelist = r->next;
+    kmem.nfree--;
+  }
   if(kmem.use_lock)
     release(&kmem.lock);
   return (char*)r;
 }
+
+void
+kmemstat(int *total, int *nfree)
+{
+  acquire(&kmem.lock);
+  *total = kmem.ntotal;
+  *nfree = kmem.nfree;
+  release(&kmem.lock);
+}
