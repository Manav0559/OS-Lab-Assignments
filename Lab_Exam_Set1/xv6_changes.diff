diff --git a/sysproc.c b/sysproc.c
index 0686d29..4e52a6c 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -89,3 +89,51 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// Question 1: counting semaphores
+int
+sys_sem_init(void)
+{
+  int id, value;
+
+  if(argint(0, &id) < 0 || argint(1, &value) < 0)
+    return -1;
+  return sem_init(id, value);
+}
+
+int
+sys_sem_wait(void)
+{
+  int id;
+
+  if(argint(0, &id) < 0)
+    return -1;
+  return sem_wait(id);
+}
+
+int
+sys_sem_post(void)
+{
+  int id;
+
+  if(argint(0, &id) < 0)
+    return -1;
+  return sem_post(id);
+}
+
+// Question 2: memory statistics and address translation
+int
+sys_freepages(void)
+{
+  return freepages();
+}
+
+int
+sys_va2pa(void)
+{
+  int va;
+
+  if(argint(0, &va) < 0)
+    return -1;
+  return uva2pa(myproc()->pgdir, (uint)va);
+}
