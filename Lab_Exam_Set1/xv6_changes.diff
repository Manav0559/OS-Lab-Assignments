diff --git a/vm.c b/vm.c
index 7134cff..02a411f 100644
--- a/vm.c
+++ b/vm.c
@@ -392,3 +392,17 @@ copyout(pde_t *pgdir, uint va, void *p, uint len)
 //PAGEBREAK!
 // Blank page.
 
+
+// Translate user virtual address va in page directory pgdir to a physical
+// address (Question 2). Returns -1 if the page is not present or is not
+// accessible from user mode (PTE_U clear).
+int
+uva2pa(pde_t *pgdir, uint va)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(pgdir, (void*)va, 0);
+  if(pte == 0 || (*pte & PTE_P) == 0 || (*pte & PTE_U) == 0)
+    return -1;
+  return PTE_ADDR(*pte) | (va & 0xFFF);
+}
