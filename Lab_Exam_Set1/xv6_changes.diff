diff --git a/memtest.c b/memtest.c
new file mode 100644
index 0000000..56a1468
--- /dev/null
+++ b/memtest.c
@@ -0,0 +1,66 @@
+// Question 2(c): free physical pages and virtual-to-physical translation.
+
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+int gvar = 42;     // global variable in the data segment
+
+int
+main(void)
+{
+  int start, after_sbrk, before_fork, after_fork, after_wait;
+  int pa_parent, pa_child, pid;
+  int fd[2];
+
+  // (i) at start-up
+  start = freepages();
+  printf(1, "(i)   freepages() at start-up        = %d\n", start);
+
+  // (ii) after growing the heap by 10 pages
+  if(sbrk(10 * 4096) == (char*)-1){
+    printf(1, "memtest: sbrk failed\n");
+    exit();
+  }
+  after_sbrk = freepages();
+  printf(1, "(ii)  freepages() after sbrk(10*4096) = %d  (used %d pages)\n",
+         after_sbrk, start - after_sbrk);
+
+  // (iii) virtual and physical address of a global variable
+  printf(1, "(iii) &gvar: va = 0x%x  pa = 0x%x\n", (uint)&gvar, va2pa((int)&gvar));
+
+  // (iv) an address that is not mapped
+  printf(1, "(iv)  va2pa(0x7FFFFFFF) = %d\n", va2pa(0x7FFFFFFF));
+
+  // (v) fork: same virtual address, different physical pages
+  pipe(fd);                       // child sends its pa to the parent
+  before_fork = freepages();
+  pid = fork();
+  if(pid < 0){
+    printf(1, "memtest: fork failed\n");
+    exit();
+  }
+  if(pid == 0){
+    pa_child = va2pa((int)&gvar);
+    write(fd[1], &pa_child, sizeof(pa_child));
+    exit();
+  }
+  after_fork = freepages();
+  pa_parent = va2pa((int)&gvar);
+  read(fd[0], &pa_child, sizeof(pa_child));
+  wait();
+  after_wait = freepages();
+  close(fd[0]);
+  close(fd[1]);
+
+  printf(1, "(v)   after fork(): &gvar va = 0x%x in both processes\n", (uint)&gvar);
+  printf(1, "      parent pa = 0x%x\n", pa_parent);
+  printf(1, "      child  pa = 0x%x  -> %s\n", pa_child,
+         pa_parent != pa_child ? "different (fork copied the page)" : "SAME (unexpected)");
+  printf(1, "      freepages() before fork        = %d\n", before_fork);
+  printf(1, "      freepages() after fork         = %d  (child holds %d pages)\n",
+         after_fork, before_fork - after_fork);
+  printf(1, "      freepages() after child reaped = %d  -> %s\n", after_wait,
+         after_wait == before_fork ? "equal to before fork, no leak" : "LEAK");
+  exit();
+}
diff --git a/sem.c b/sem.c
new file mode 100644
index 0000000..917e9ff
--- /dev/null
+++ b/sem.c
@@ -0,0 +1,97 @@
+// Counting semaphores for user processes (Question 1).
+// A fixed table of NSEM semaphores lives in the kernel, so it is shared by
+// a parent and every child it creates with fork().
+
+#include "types.h"
+#include "defs.h"
+#include "param.h"
+#include "mmu.h"
+#include "proc.h"
+#include "spinlock.h"
+
+#define NSEM 8
+
+struct sem {
+  int value;      // current count (never negative)
+  int used;       // 1 once sem_init has been called on this id
+};
+
+struct {
+  struct spinlock lock;   // protects every entry of sem[]
+  struct sem sem[NSEM];
+} semtable;
+
+// Called once from main() at boot.
+void
+seminit(void)
+{
+  initlock(&semtable.lock, "semtable");
+}
+
+static int
+badid(int id)
+{
+  return id < 0 || id >= NSEM;
+}
+
+// Set semaphore id to value (value >= 0). Returns 0, or -1 on bad id/value.
+int
+sem_init(int id, int value)
+{
+  if(badid(id) || value < 0)
+    return -1;
+  acquire(&semtable.lock);
+  semtable.sem[id].value = value;
+  semtable.sem[id].used = 1;
+  release(&semtable.lock);
+  return 0;
+}
+
+// P(): block while the value is 0, then decrement it.
+int
+sem_wait(int id)
+{
+  struct sem *s;
+
+  if(badid(id))
+    return -1;
+  s = &semtable.sem[id];
+  acquire(&semtable.lock);
+  if(!s->used){
+    release(&semtable.lock);
+    return -1;
+  }
+  // Re-check after every wake-up: sem_post wakes all waiters but only
+  // one of them may get the unit. sleep() releases semtable.lock
+  // atomically, so a post between the check and the sleep is not lost.
+  while(s->value == 0){
+    if(myproc()->killed){
+      release(&semtable.lock);
+      return -1;
+    }
+    sleep(s, &semtable.lock);
+  }
+  s->value--;
+  release(&semtable.lock);
+  return 0;
+}
+
+// V(): increment the value and wake every process sleeping on it.
+int
+sem_post(int id)
+{
+  struct sem *s;
+
+  if(badid(id))
+    return -1;
+  s = &semtable.sem[id];
+  acquire(&semtable.lock);
+  if(!s->used){
+    release(&semtable.lock);
+    return -1;
+  }
+  s->value++;
+  wakeup(s);   // called with semtable.lock held, same lock sem_wait sleeps with
+  release(&semtable.lock);
+  return 0;
+}
diff --git a/synctest.c b/synctest.c
new file mode 100644
index 0000000..bb0d832
--- /dev/null
+++ b/synctest.c
@@ -0,0 +1,53 @@
+// Question 1(c): three children print A, B, C five times each, forced into
+// the order A B C A B C ... using only semaphores (no sleep(), no spinning).
+//
+// Semaphore i lets child i print once. It is initialised to 1 for child A and
+// 0 for B and C. After printing, child i posts semaphore (i+1)%3, handing the
+// turn to the next child, so exactly one child can print at any moment.
+
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+#define NCHILD 3
+#define ROUNDS 5
+
+int
+main(void)
+{
+  int i, r;
+
+  // error cases required by 1(b)
+  printf(1, "sem_init(8, 1)  = %d  (invalid id)\n", sem_init(8, 1));
+  printf(1, "sem_init(0, -1) = %d  (negative value)\n", sem_init(0, -1));
+  printf(1, "sem_wait(-1)    = %d  (invalid id)\n", sem_wait(-1));
+  printf(1, "sem_post(7)     = %d  (never initialised)\n", sem_post(7));
+  printf(1, "sem_wait(7)     = %d  (never initialised)\n", sem_wait(7));
+
+  if(sem_init(0, 1) < 0 || sem_init(1, 0) < 0 || sem_init(2, 0) < 0){
+    printf(1, "synctest: sem_init failed\n");
+    exit();
+  }
+  printf(1, "sem 0,1,2 initialised to 1,0,0\n");
+
+  for(i = 0; i < NCHILD; i++){
+    int pid = fork();
+    if(pid < 0){
+      printf(1, "synctest: fork failed\n");
+      exit();
+    }
+    if(pid == 0){
+      for(r = 0; r < ROUNDS; r++){
+        sem_wait(i);                    // wait for my turn
+        printf(1, "%c ", 'A' + i);
+        sem_post((i + 1) % NCHILD);     // pass the turn on
+      }
+      exit();
+    }
+  }
+
+  for(i = 0; i < NCHILD; i++)
+    wait();
+  printf(1, "\nDone\n");
+  exit();
+}
